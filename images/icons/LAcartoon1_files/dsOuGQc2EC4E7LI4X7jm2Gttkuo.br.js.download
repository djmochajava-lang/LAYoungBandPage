var AjaxUnloadUtil=function(){function n(){var n=this;this._handleAjaxUnload=function(t){sj_evt.bind("ajax.unload",function(){t&&t.length&&t[0]&&typeof t[0].style=="object"&&(t[0].style.display="none")});sj_evt.bind("unload",function(){t&&t.length&&t[0]&&typeof t[0].remove=="function"&&t[0].remove()});sj_evt.unbind("bnp.notif.shown",n._handleAjaxUnload);sj_evt.unbind("bnp.embed.ready",n._handleAjaxUnload)}}return n}()